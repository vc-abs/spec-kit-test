# Environment Variables for GenAI Asset Generation System

# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Alternative: OpenAI API Configuration
# Uncomment if using OpenAI DALL-E instead of Gemini
# OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Anthropic API Configuration
# Uncomment if using Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Configuration
# Gemini model for image generation (via Imagen)
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_IMAGE_MODEL=imagen-3.0-generate-001

# Image Generation Settings
DEFAULT_IMAGE_WIDTH=1024
DEFAULT_IMAGE_HEIGHT=1024
DEFAULT_ASPECT_RATIO=1:1

# DVC Remote Configuration (for future cloud storage)
# Uncomment and configure when moving to production
# DVC_REMOTE_URL=s3://your-bucket/dvc-cache
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=yaml

# Asset Generation Limits
MAX_BATCH_SIZE=5
GENERATION_TIMEOUT=300

# Safety and Content Filtering
ENABLE_CONTENT_FILTER=true
SAFETY_LEVEL=medium

# Development Settings
DEBUG_MODE=false
MOCK_API_CALLS=false
